<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Installed Modeler defaults to a 12-second initial Chromium page handshake.
         Configure this dedicated host, never the vendor installation. This is not
         a lifetime limit or an automatic process cancellation policy. -->
    <add key="TimeElapsedWaitPage" value="120000" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false" />
  </runtime>
</configuration>
