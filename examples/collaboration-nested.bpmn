<?xml version="1.0" encoding="utf-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_Collaboration" targetNamespace="https://github.com/h0w4r/MCP-Bizagi/examples">
  <!-- Original acceptance input. Geometry is explicit; visual compatibility is a separate gate. -->
  <process id="Process_Fulfilment" name="Fulfilment" isExecutable="false">
    <documentation>Original multi-pool, lane and nested subprocess example.</documentation>
    <laneSet id="LaneSet_Operations">
      <lane id="Lane_Intake" name="Intake"><flowNodeRef>Start_Order</flowNodeRef><flowNodeRef>Task_Assess</flowNodeRef><flowNodeRef>Gateway_Decide</flowNodeRef></lane>
      <lane id="Lane_Delivery" name="Delivery"><flowNodeRef>SubProcess_Fulfil</flowNodeRef><flowNodeRef>End_Fulfilled</flowNodeRef><flowNodeRef>End_Rejected</flowNodeRef></lane>
    </laneSet>
    <startEvent id="Start_Order" name="Order received"><outgoing>Sequence_Intake</outgoing></startEvent>
    <userTask id="Task_Assess" name="Assess order"><incoming>Sequence_Intake</incoming><outgoing>Sequence_Decide</outgoing></userTask>
    <exclusiveGateway id="Gateway_Decide" name="Accepted" gatewayDirection="Diverging"><incoming>Sequence_Decide</incoming><outgoing>Sequence_Accepted</outgoing><outgoing>Sequence_Rejected</outgoing></exclusiveGateway>
    <subProcess id="SubProcess_Fulfil" name="Fulfil order">
      <documentation>Nested modelling survives reopening as native objects.</documentation>
      <incoming>Sequence_Accepted</incoming><outgoing>Sequence_Done</outgoing>
      <startEvent id="Start_Fulfil" name="Begin fulfilment"><outgoing>Sequence_Nested_Start</outgoing></startEvent>
      <subProcess id="SubProcess_Pack" name="Prepare parcel">
        <incoming>Sequence_Nested_Start</incoming><outgoing>Sequence_Nested_End</outgoing>
        <startEvent id="Start_Pack" name="Begin preparation"><outgoing>Sequence_Pack_Start</outgoing></startEvent>
        <task id="Task_Pack" name="Pack parcel — 東京"><incoming>Sequence_Pack_Start</incoming><outgoing>Sequence_Pack_End</outgoing></task>
        <endEvent id="End_Pack" name="Parcel ready"><incoming>Sequence_Pack_End</incoming></endEvent>
        <sequenceFlow id="Sequence_Pack_Start" sourceRef="Start_Pack" targetRef="Task_Pack" />
        <sequenceFlow id="Sequence_Pack_End" sourceRef="Task_Pack" targetRef="End_Pack" />
      </subProcess>
      <endEvent id="End_Fulfil" name="Fulfilment complete"><incoming>Sequence_Nested_End</incoming></endEvent>
      <sequenceFlow id="Sequence_Nested_Start" sourceRef="Start_Fulfil" targetRef="SubProcess_Pack" />
      <sequenceFlow id="Sequence_Nested_End" sourceRef="SubProcess_Pack" targetRef="End_Fulfil" />
    </subProcess>
    <endEvent id="End_Fulfilled" name="Order fulfilled"><incoming>Sequence_Done</incoming></endEvent>
    <endEvent id="End_Rejected" name="Order rejected"><incoming>Sequence_Rejected</incoming></endEvent>
    <sequenceFlow id="Sequence_Intake" sourceRef="Start_Order" targetRef="Task_Assess" />
    <sequenceFlow id="Sequence_Decide" sourceRef="Task_Assess" targetRef="Gateway_Decide" />
    <sequenceFlow id="Sequence_Accepted" name="Yes" sourceRef="Gateway_Decide" targetRef="SubProcess_Fulfil" />
    <sequenceFlow id="Sequence_Rejected" name="No" sourceRef="Gateway_Decide" targetRef="End_Rejected" />
    <sequenceFlow id="Sequence_Done" sourceRef="SubProcess_Fulfil" targetRef="End_Fulfilled" />
  </process>
  <process id="Process_Supplier" name="Supplier" isExecutable="false">
    <startEvent id="Start_Supply" name="Supply request"><outgoing>Sequence_Supply</outgoing></startEvent>
    <task id="Task_Supply" name="Supply parcel"><incoming>Sequence_Supply</incoming><outgoing>Sequence_Supplied</outgoing></task>
    <endEvent id="End_Supply" name="Supplied"><incoming>Sequence_Supplied</incoming></endEvent>
    <sequenceFlow id="Sequence_Supply" sourceRef="Start_Supply" targetRef="Task_Supply" />
    <sequenceFlow id="Sequence_Supplied" sourceRef="Task_Supply" targetRef="End_Supply" />
  </process>
  <collaboration id="Collaboration_Fulfilment" name="Nested fulfilment">
    <participant id="Pool_Fulfilment" name="Operations" processRef="Process_Fulfilment" />
    <participant id="Pool_Supplier" name="Supplier" processRef="Process_Supplier" />
    <messageFlow id="Message_Request" name="Supply request" sourceRef="Task_Assess" targetRef="Task_Supply" />
  </collaboration>
  <bpmndi:BPMNDiagram id="Diagram_Fulfilment">
    <bpmndi:BPMNPlane id="Plane_Fulfilment" bpmnElement="Collaboration_Fulfilment">
      <bpmndi:BPMNShape id="Shape_Operations" bpmnElement="Pool_Fulfilment" isHorizontal="true"><dc:Bounds x="20" y="20" width="1100" height="580" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Intake" bpmnElement="Lane_Intake" isHorizontal="true"><dc:Bounds x="50" y="20" width="1070" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Delivery" bpmnElement="Lane_Delivery" isHorizontal="true"><dc:Bounds x="50" y="190" width="1070" height="410" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartOrder" bpmnElement="Start_Order"><dc:Bounds x="100" y="90" width="30" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Assess" bpmnElement="Task_Assess"><dc:Bounds x="240" y="65" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Decide" bpmnElement="Gateway_Decide"><dc:Bounds x="460" y="80" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Fulfil" bpmnElement="SubProcess_Fulfil" isExpanded="true"><dc:Bounds x="200" y="230" width="720" height="290" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartFulfil" bpmnElement="Start_Fulfil"><dc:Bounds x="230" y="340" width="30" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Pack" bpmnElement="SubProcess_Pack" isExpanded="true"><dc:Bounds x="320" y="280" width="460" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartPack" bpmnElement="Start_Pack"><dc:Bounds x="350" y="350" width="30" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PackTask" bpmnElement="Task_Pack"><dc:Bounds x="460" y="325" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndPack" bpmnElement="End_Pack"><dc:Bounds x="700" y="350" width="30" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndFulfil" bpmnElement="End_Fulfil"><dc:Bounds x="850" y="340" width="30" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Fulfilled" bpmnElement="End_Fulfilled"><dc:Bounds x="1030" y="340" width="30" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Rejected" bpmnElement="End_Rejected"><dc:Bounds x="1030" y="540" width="30" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Supplier" bpmnElement="Pool_Supplier" isHorizontal="true"><dc:Bounds x="20" y="680" width="700" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartSupply" bpmnElement="Start_Supply"><dc:Bounds x="100" y="750" width="30" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Supply" bpmnElement="Task_Supply"><dc:Bounds x="260" y="725" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndSupply" bpmnElement="End_Supply"><dc:Bounds x="570" y="750" width="30" height="30" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Intake" bpmnElement="Sequence_Intake"><di:waypoint x="130" y="105" /><di:waypoint x="240" y="105" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Decide" bpmnElement="Sequence_Decide"><di:waypoint x="360" y="105" /><di:waypoint x="460" y="105" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Accepted" bpmnElement="Sequence_Accepted"><di:waypoint x="485" y="130" /><di:waypoint x="485" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Rejected" bpmnElement="Sequence_Rejected"><di:waypoint x="510" y="105" /><di:waypoint x="1090" y="105" /><di:waypoint x="1090" y="555" /><di:waypoint x="1060" y="555" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Done" bpmnElement="Sequence_Done"><di:waypoint x="920" y="355" /><di:waypoint x="1030" y="355" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_NestedStart" bpmnElement="Sequence_Nested_Start"><di:waypoint x="260" y="355" /><di:waypoint x="320" y="355" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_NestedEnd" bpmnElement="Sequence_Nested_End"><di:waypoint x="780" y="355" /><di:waypoint x="850" y="355" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_PackStart" bpmnElement="Sequence_Pack_Start"><di:waypoint x="380" y="365" /><di:waypoint x="460" y="365" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_PackEnd" bpmnElement="Sequence_Pack_End"><di:waypoint x="600" y="365" /><di:waypoint x="700" y="365" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Supply" bpmnElement="Sequence_Supply"><di:waypoint x="130" y="765" /><di:waypoint x="260" y="765" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Supplied" bpmnElement="Sequence_Supplied"><di:waypoint x="380" y="765" /><di:waypoint x="570" y="765" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Message" bpmnElement="Message_Request"><di:waypoint x="300" y="145" /><di:waypoint x="150" y="145" /><di:waypoint x="150" y="640" /><di:waypoint x="320" y="640" /><di:waypoint x="320" y="725" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
