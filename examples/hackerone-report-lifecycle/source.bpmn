<?xml version="1.0" encoding="utf-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_HackerOne" targetNamespace="https://github.com/h0w4r/MCP-Bizagi/examples/hackerone" exporter="MCP-Bizagi operator demo" exporterVersion="0.7.0-alpha.1">
  <process id="Process_HackerOne" name="Gestión coordinada de un reporte en HackerOne" isExecutable="false">
    <documentation>Vista de negocio simplificada: el triaje puede hacerlo el programa o el servicio de HackerOne. La recompensa no es obligatoria ni depende necesariamente del cierre. No se representan plazos universales. Fuentes oficiales consultadas el 17/09/2026: https://docs.hackerone.com/en/articles/8475030-report-states ; https://docs.hackerone.com/en/articles/8473994-submitting-reports ; https://docs.hackerone.com/en/articles/15518592-post-submission-guide</documentation>
    <laneSet id="LaneSet_HackerOne">
      <lane id="Lane_Researcher" name="Investigador">
        <flowNodeRef>Start</flowNodeRef>
        <flowNodeRef>Scope</flowNodeRef>
        <flowNodeRef>Research</flowNodeRef>
        <flowNodeRef>Submit</flowNodeRef>
        <flowNodeRef>MoreEvidence</flowNodeRef>
      </lane>
      <lane id="Lane_Program" name="Equipo del programa / triaje">
        <flowNodeRef>Triage</flowNodeRef>
        <flowNodeRef>NeedInfo</flowNodeRef>
        <flowNodeRef>Actionable</flowNodeRef>
        <flowNodeRef>CloseOther</flowNodeRef>
        <flowNodeRef>EndOther</flowNodeRef>
        <flowNodeRef>Accept</flowNodeRef>
        <flowNodeRef>Fix</flowNodeRef>
        <flowNodeRef>Verify</flowNodeRef>
        <flowNodeRef>Fixed</flowNodeRef>
        <flowNodeRef>Resolve</flowNodeRef>
        <flowNodeRef>Disclose</flowNodeRef>
        <flowNodeRef>Publish</flowNodeRef>
        <flowNodeRef>End</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start" name="Inicio">
      <outgoing>F01</outgoing>
    </startEvent>
    <task id="Scope" name="Elegir programa y revisar reglas y alcance">
      <incoming>F01</incoming>
      <outgoing>F02</outgoing>
    </task>
    <task id="Research" name="Investigar y documentar el hallazgo">
      <documentation>Investigación dentro de las reglas y del alcance autorizado del programa. Registrar un hallazgo reproducible sin incluir aquí técnicas de explotación.</documentation>
      <incoming>F02</incoming>
      <outgoing>F03</outgoing>
    </task>
    <task id="Submit" name="Enviar reporte en HackerOne">
      <documentation>Preparar título, activo, tipo de problema, evidencia e impacto. Al enviarse, el reporte queda pendiente de validación (New).</documentation>
      <incoming>F03</incoming>
      <outgoing>F04</outgoing>
    </task>
    <task id="MoreEvidence" name="Aportar información adicional">
      <documentation>Responder en el reporte a la solicitud Needs More Info. Este esquema muestra el retorno normal y omite vencimientos y mediaciones.</documentation>
      <incoming>F06</incoming>
      <outgoing>F07</outgoing>
    </task>
    <task id="Triage" name="Revisar alcance, evidencia e impacto">
      <documentation>Lo realiza el equipo del programa o el servicio de triaje contratado de HackerOne. Pending Program Review solo aplica al servicio de triaje gestionado; la decisión final corresponde al programa.</documentation>
      <incoming>F04</incoming>
      <incoming>F07</incoming>
      <outgoing>F05</outgoing>
    </task>
    <exclusiveGateway id="NeedInfo" name="¿Falta información?" gatewayDirection="Diverging">
      <incoming>F05</incoming>
      <outgoing>F06</outgoing>
      <outgoing>F08</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Actionable" name="¿Requiere acción?" gatewayDirection="Diverging">
      <documentation>Determinar si el reporte validado debe avanzar a remediación. La clasificación de cierres depende del contenido y de la política, no solo de una decisión binaria de validez.</documentation>
      <incoming>F08</incoming>
      <outgoing>F09</outgoing>
      <outgoing>F11</outgoing>
    </exclusiveGateway>
    <task id="CloseOther" name="Cerrar con motivo: Duplicate / Informative / Not Applicable">
      <incoming>F09</incoming>
      <outgoing>F10</outgoing>
    </task>
    <endEvent id="EndOther" name="Cierre alternativo">
      <incoming>F10</incoming>
    </endEvent>
    <task id="Accept" name="Validar y priorizar: Triaged">
      <incoming>F11</incoming>
      <outgoing>F12</outgoing>
    </task>
    <task id="Fix" name="Corregir la vulnerabilidad">
      <incoming>F12</incoming>
      <incoming>F15</incoming>
      <outgoing>F13</outgoing>
    </task>
    <task id="Verify" name="Verificar la corrección">
      <documentation>El equipo verifica la solución. Si solicita una nueva prueba al investigador, puede usar Retesting. Si falla la verificación, vuelve a remediación.</documentation>
      <incoming>F13</incoming>
      <outgoing>F14</outgoing>
    </task>
    <exclusiveGateway id="Fixed" name="¿Corregida?" gatewayDirection="Diverging">
      <incoming>F14</incoming>
      <outgoing>F15</outgoing>
      <outgoing>F16</outgoing>
    </exclusiveGateway>
    <task id="Resolve" name="Cerrar como resuelto: Resolved">
      <incoming>F16</incoming>
      <outgoing>F17</outgoing>
    </task>
    <exclusiveGateway id="Disclose" name="¿Divulgación acordada?" gatewayDirection="Diverging">
      <documentation>Paso opcional posterior al cierre, sujeto a la configuración de divulgación, la coordinación y las autorizaciones del programa. No se publica automáticamente todo reporte.</documentation>
      <incoming>F17</incoming>
      <outgoing>F18</outgoing>
      <outgoing>F20</outgoing>
    </exclusiveGateway>
    <task id="Publish" name="Publicar según la política acordada">
      <incoming>F18</incoming>
      <outgoing>F19</outgoing>
    </task>
    <endEvent id="End" name="Gestión finalizada">
      <incoming>F19</incoming>
      <incoming>F20</incoming>
    </endEvent>
    <sequenceFlow id="F01" sourceRef="Start" targetRef="Scope" />
    <sequenceFlow id="F02" sourceRef="Scope" targetRef="Research" />
    <sequenceFlow id="F03" sourceRef="Research" targetRef="Submit" />
    <sequenceFlow id="F04" sourceRef="Submit" targetRef="Triage" name="New" />
    <sequenceFlow id="F05" sourceRef="Triage" targetRef="NeedInfo" />
    <sequenceFlow id="F06" sourceRef="NeedInfo" targetRef="MoreEvidence" name="Sí · Needs More Info" />
    <sequenceFlow id="F07" sourceRef="MoreEvidence" targetRef="Triage" name="Ampliación" />
    <sequenceFlow id="F08" sourceRef="NeedInfo" targetRef="Actionable" name="No" />
    <sequenceFlow id="F09" sourceRef="Actionable" targetRef="CloseOther" name="No" />
    <sequenceFlow id="F10" sourceRef="CloseOther" targetRef="EndOther" />
    <sequenceFlow id="F11" sourceRef="Actionable" targetRef="Accept" name="Sí" />
    <sequenceFlow id="F12" sourceRef="Accept" targetRef="Fix" />
    <sequenceFlow id="F13" sourceRef="Fix" targetRef="Verify" />
    <sequenceFlow id="F14" sourceRef="Verify" targetRef="Fixed" />
    <sequenceFlow id="F15" sourceRef="Fixed" targetRef="Fix" name="No · volver a corregir" />
    <sequenceFlow id="F16" sourceRef="Fixed" targetRef="Resolve" name="Sí" />
    <sequenceFlow id="F17" sourceRef="Resolve" targetRef="Disclose" />
    <sequenceFlow id="F18" sourceRef="Disclose" targetRef="Publish" name="Sí" />
    <sequenceFlow id="F19" sourceRef="Publish" targetRef="End" />
    <sequenceFlow id="F20" sourceRef="Disclose" targetRef="End" name="No · mantener privado" />
    <textAnnotation id="Note_Triage">
      <text>El triaje puede hacerlo el programa o HackerOne, si se contrató ese servicio.</text>
    </textAnnotation>
    <association id="Assoc_Note_Triage" sourceRef="Triage" targetRef="Note_Triage" associationDirection="None" />
    <textAnnotation id="Note_Bounty">
      <text>Recompensa opcional: según elegibilidad y política. Puede gestionarse antes o después de la resolución.</text>
    </textAnnotation>
    <association id="Assoc_Note_Bounty" sourceRef="Accept" targetRef="Note_Bounty" associationDirection="None" />
    <textAnnotation id="Note_Retest">
      <text>Retesting: nueva verificación por el investigador, cuando el programa la solicita.</text>
    </textAnnotation>
    <association id="Assoc_Note_Retest" sourceRef="Verify" targetRef="Note_Retest" associationDirection="None" />
    <textAnnotation id="Note_Disclosure">
      <text>La divulgación no es obligatoria. Depende de la política y la coordinación con el programa.</text>
    </textAnnotation>
    <association id="Assoc_Note_Disclosure" sourceRef="Disclose" targetRef="Note_Disclosure" associationDirection="None" />
  </process>
  <collaboration id="Collaboration_HackerOne" name="HackerOne — ciclo de un reporte">
    <participant id="Pool_HackerOne" name="HackerOne — ciclo de un reporte de vulnerabilidad" processRef="Process_HackerOne" />
  </collaboration>
